# Copie ce fichier en ".env" et remplis les deux valeurs.
# Ne partage jamais ton .env : le token donne le contrôle du bot.

# Portail développeur Discord > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Clic droit sur ton serveur > Copier l'identifiant du serveur (mode développeur activé)
GUILD_ID=
